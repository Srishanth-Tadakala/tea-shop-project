# Server Environment Variables - Example / Template
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Domains (for CORS and Socket.IO)
# These domains must exactly match where your frontend apps are served from
# Include protocol (http:// or https://) and port if applicable

# ⚠️  DOMAIN SEPARATION RULES:
# 1. CLIENT_WEB_DOMAIN: Public customer website domain
# 2. ADMIN_WEB_DOMAIN: Admin dashboard domain (MUST BE DIFFERENT)
# 3. Admin routes are ONLY accessible from ADMIN_WEB_DOMAIN
# 4. Client routes are public (no domain restriction on GET requests)

# Development
CLIENT_WEB_DOMAIN=http://localhost:5173
ADMIN_WEB_DOMAIN=http://localhost:5174

# Production (uncomment and update for prod)
# CLIENT_WEB_DOMAIN=https://amruthulya.com
# ADMIN_WEB_DOMAIN=https://admin.amruthulya.com

# Database - MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/teashop?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-256-char-or-longer
JWT_EXPIRE=30d

# Cookie Configuration (in days)
COOKIE_EXPIRE=30

# Notes:
# 1. CLIENT_WEB_DOMAIN: Public customer site (e.g., http://localhost:5173 for dev, https://amruthulya.com for prod)
# 2. ADMIN_WEB_DOMAIN: Admin dashboard (e.g., http://localhost:5174 for dev, https://admin.amruthulya.com for prod)
# 3. Both domains are automatically added to CORS and Socket.IO whitelists
# 4. Admin endpoints are ONLY accessible from ADMIN_WEB_DOMAIN
# 5. JWT_SECRET: Should be a long, random string (256+ characters recommended for production)
# 6. MONGODB_URI: Update password and cluster name - get from MongoDB Atlas dashboard
# 7. PORT: Default 5000 - change if port is already in use
# 8. SECURITY: Admin routes blocked if accessed from CLIENT_WEB_DOMAIN
