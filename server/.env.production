# Server Environment Variables - Production

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Domains (for CORS and Socket.IO) - Production
# UPDATE THESE to your actual production domains
CLIENT_WEB_DOMAIN=https://yourdomain.com
ADMIN_WEB_DOMAIN=https://admin.yourdomain.com

# Database - MongoDB Atlas
# UPDATE with your production MongoDB credentials
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/teashop?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Use a strong, random secret (32+ characters)
# DO NOT use the example value - generate a new one
JWT_SECRET=your-super-strong-random-secret-key-minimum-32-characters-required
JWT_EXPIRE=30d

# Cookie Configuration (in days)
COOKIE_EXPIRE=7
COOKIE_EXPIRE=30
