# Admin-Web Dashboard - Environment Variables

# API Base URL (DO NOT include /api suffix - it's added by the app)
# Development: http://localhost:5000
# Production: https://api.amruthulya.com
VITE_API_URL=http://localhost:5000

# WebSocket URL for Socket.IO real-time updates (SAME as API URL)
# Development: http://localhost:5000
# Production: https://api.amruthulya.com
VITE_WS_URL=http://localhost:5000

# Optional: Application environment
# VITE_ENV=development
